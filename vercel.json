{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://pi-miniproject-2.onrender.com/api/:path*" }
  ],
  "redirects": [
    { "source": "/sitemap.xml", "destination": "/sitemap.xml", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}


